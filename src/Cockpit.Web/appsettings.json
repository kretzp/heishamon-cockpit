{
  "Urls": "http://127.0.0.1:5080",
  "AllowedHosts": "*",
  "Source": "simulator",
  "Simulator": {
    "Scenario": "cycle"
  },
  "Telemetry": {
    "FreshSeconds": 120,
    "MaxPairSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "History": {
    "SampleSeconds": 30,
    "RetentionDays": 700
  },
  "Control": {
    "Enabled": false
  },
  "LiveTest": {
    "Enabled": false
  },
  "HeatingCurve": {
    "Enabled": false
  },
  "LiveControl": {
    "Enabled": false,
    "ProfileConfirmed": false,
    "AllowSharedCredentials": false,
    "Armed": false
  }
}
